// Database schema. Change it, then run `npm run db:migrate -- --name <what_changed>`.
// Never hand-write files in prisma/migrations/: the Prisma CLI generates them.
// SQLite has no enums here, so allowed values (category, condition, status) are
// checked with Zod in src/data/schemas.ts before anything is written.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// One physical item that can be leased, returned, refurbished and leased again.
// Mirrors data/assets.json; `usage` is stored as two columns.
model Asset {
  id                      String                 @id
  category                String // e_bike | laptop | farm_machine
  make                    String
  model                   String
  model_year              Int
  serial_number           String                 @unique
  condition               String // new | like_new | good | fair | poor
  usage_unit              String // km | battery_cycles | engine_hours
  usage_value             Int
  previous_lives          Int
  status                  String // available | reserved | returned | sold
  current_net_price_cents Int?
  created_at              DateTime               @default(now())
  updated_at              DateTime               @updatedAt
  quotes                  DemoQuote[]
  leases                  DemoLease[]
  inspections             DemoReturnInspection[]

  @@index([category])
}

model DemoQuote {
  id            String     @id @default(cuid())
  asset_id      String
  asset         Asset      @relation(fields: [asset_id], references: [id])
  customer_id   String
  quote_date    String
  locked        Boolean
  term_months   Int
  down_cents    Int
  price_cents   Int
  price_version Int
  lease         DemoLease?
  created_at    DateTime   @default(now())

  @@index([customer_id])
}

model DemoLease {
  id                  String                @id @default(cuid())
  quote_id            String                @unique
  quote               DemoQuote             @relation(fields: [quote_id], references: [id])
  asset_id            String
  asset               Asset                 @relation(fields: [asset_id], references: [id])
  customer_id         String
  signed_date         String
  end_date            String
  term_months         Int
  list_price_cents    Int
  down_cents          Int
  monthly_net_cents   Int
  buyout_cents        Int
  price_version       Int
  return_requested_on String?
  bought_out_on       String?
  invoices            DemoInvoice[]
  receipt             DemoAssetReceipt?
  early_exit          DemoEarlyExit?
  inspection          DemoReturnInspection?
  created_at          DateTime              @default(now())

  @@index([customer_id])
}

// Early-return settlement snapshot; no new invoice is issued for the settlement.
model DemoEarlyExit {
  id                       String    @id @default(cuid())
  lease_id                 String    @unique
  lease                    DemoLease @relation(fields: [lease_id], references: [id], onDelete: Cascade)
  requested_on             String
  months_elapsed           Int
  remaining_contract_cents Int
  market_value_cents       Int
  settlement_cents         Int
  created_at               DateTime  @default(now())
}

// A return inspection may come from a signed lease or a historic data-pack item.
model DemoReturnInspection {
  id            String             @id @default(cuid())
  asset_id      String
  asset         Asset              @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  lease_id      String?            @unique
  lease         DemoLease?         @relation(fields: [lease_id], references: [id], onDelete: SetNull)
  inspected_on  String
  condition     String // new | like_new | good | fair | poor
  usage_unit    String // km | battery_cycles | engine_hours
  usage_value   Int
  created_at    DateTime           @default(now())
  refurbishment DemoRefurbishment?

  @@index([asset_id, inspected_on])
}

// One deterministic refurbishment/matching decision for an inspected return.
model DemoRefurbishment {
  id                 String               @id @default(cuid())
  inspection_id      String               @unique
  inspection         DemoReturnInspection @relation(fields: [inspection_id], references: [id], onDelete: Cascade)
  completed_on       String
  target_condition   String
  usage_after        Int
  cost_cents         Int
  market_price_cents Int
  monthly_net_cents  Int
  term_months        Int
  waitlist_id        String?
  match_status       String               @default("unassigned")
  steps_json         String
  created_at         DateTime             @default(now())
}

// Customer's one-time confirmation of the item's delivered state for this lease.
model DemoAssetReceipt {
  id          String    @id @default(cuid())
  lease_id    String    @unique
  lease       DemoLease @relation(fields: [lease_id], references: [id])
  received_on String
  condition   String // new | like_new | good | fair | poor
  usage_unit  String // km | battery_cycles | engine_hours
  usage_value Int
  created_at  DateTime  @default(now())
}

model DemoInvoice {
  id                   String    @id @default(cuid())
  lease_id             String
  lease                DemoLease @relation(fields: [lease_id], references: [id])
  issue_date           String
  due_date             String
  period_start         String
  period_end_exclusive String
  net_cents            Int
  vat_rate_percent     Float
  vat_cents            Int
  total_cents          Int

  @@index([lease_id, issue_date])
}

// Who changed what, and when. Written in the same transaction as the change
// (see src/server/audit.ts), so a change without an audit row cannot exist.
model AuditLog {
  id           Int      @id @default(autoincrement())
  created_at   DateTime @default(now())
  actor        String
  action       String // e.g. asset.status_changed
  entity_type  String // e.g. asset
  entity_id    String
  details_json String? // JSON text, e.g. {"from":"available","to":"reserved"}

  @@index([entity_type, entity_id])
  @@index([created_at])
}
